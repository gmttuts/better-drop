<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>BetterDrop cần truy cập mạng nội bộ để tìm và gửi file tới máy khác.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_betterdrop._tcp</string>
  </array>
  <key>NSCameraUsageDescription</key>
  <string>BetterDrop dùng camera để quét mã QR kết nối với máy tính.</string>
  <!-- File nhận được hiện trong app Tệp (Files) > Trên iPhone > BetterDrop -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
</dict>
</plist>
