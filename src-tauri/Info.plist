<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>BetterDrop cần truy cập mạng nội bộ để tìm và gửi file tới máy tính khác.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_betterdrop._tcp</string>
  </array>
  <!-- "Mở bằng BetterDrop": mọi loại file và thư mục, ưu tiên thấp (không giành app mặc định). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>File để gửi bằng BetterDrop</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.item</string>
        <string>public.folder</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
