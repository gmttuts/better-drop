{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterDrop",
  "version": "0.3.5",
  "identifier": "com.nguyentuyen.betterdrop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BetterDrop",
        "width": 880,
        "height": 640,
        "minWidth": 420,
        "minHeight": 480,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQ0EwRDk4RjY1MkI0MEUKUldRT3RGTDJtQTNLcmhPTWFBZ1Y5d25yNTJjQXFiZy9BVy9WdFpCODQvTlhjYlNtWnMvMUhnU3oK",
      "endpoints": [
        "https://github.com/gmttuts/better-drop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
